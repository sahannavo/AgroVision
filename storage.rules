rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Diagnosis images — owner can read and write; path is diagnoses/{uid}/{file}
    match /diagnoses/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Profile photos — owner can read and write
    match /profiles/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
